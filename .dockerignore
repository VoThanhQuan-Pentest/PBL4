.git
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Never send local credentials or TLS material to a Docker build context.
.secrets/
**/.secrets/
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.crt
**/*.cer
**/id_rsa
**/id_ed25519
**/ssh_host_*_key

# Terraform working state may contain credentials and provisioned values.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfvars
!**/*.tfvars.example

# Generated observability state belongs on the host/volumes, not in images.
observability/runtime/
observability/data/
observability/logs/
observability/**/runtime/
observability/**/data/
observability/**/logs/
nginx-logs/
filebeat-data/
elasticsearch-data/
logstash-data/

backend/target
frontend/node_modules
frontend/dist
frontend/playwright-report
frontend/test-results
