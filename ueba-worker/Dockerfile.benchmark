# Offline verification only: reuse the project's existing pinned JRE and local
# worker dependency image. No extra packages, credentials, ports or services.
FROM eclipse-temurin:21-jre-jammy@sha256:affcab5356e1270ac35d2361ee83135af2f03e8d580eca78a6d5d6fdbf048db0 AS existing_jre
FROM flare-ueba-worker:local
COPY --from=existing_jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
USER 10001:10001
ENTRYPOINT ["python"]
